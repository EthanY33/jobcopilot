# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (Prisma)
DATABASE_URL=postgresql://postgres:...@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:...@db.YOUR_PROJECT.supabase.co:5432/postgres
# Supabase CA certificate path, used by apply:policies to verify the database certificate
# DB_SSL_CA_FILE=

# Claude
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override Anthropic API base URL (used by e2e mock + future BYO providers)
# ANTHROPIC_BASE_URL=

# Auth allowlist (required in production, see docs/DEPLOY.md)
# Comma-separated emails that may sign in. Case-insensitive, spaces ignored.
# Unset or empty: everyone may sign in outside production, and nobody may in
# a production build (the server logs one line naming this variable).
# If you set it locally, add e2e@jobcopilot.test or the Playwright suite
# cannot get past the middleware.
# AUTH_ALLOWED_EMAILS=you@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
