{
  "name": "@jobcopilot/db",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "test": "node --test scripts/apply-policies.test.mjs",
    "apply:policies": "node --env-file=../../.env scripts/apply-policies.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0"
  },
  "devDependencies": {
    "pg": "^8.20.0",
    "prisma": "^5.15.0",
    "typescript": "^5.4.5"
  }
}
